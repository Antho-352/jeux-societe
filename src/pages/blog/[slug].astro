---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Toc from '../../components/blog/Toc.astro';
import AskAi from '../../components/blog/AskAi.astro';
import HubCta from '../../components/blog/HubCta.astro';
import PostCard from '../../components/blog/PostCard.astro';
import Faq from '../../components/Faq.astro';
import { BLOG_CATEGORY_LABEL, blogCategoryUrl, fmtDate, livePosts, postUrl, readingMinutes, relatedPosts } from '../../lib/blog';
import { breadcrumbLd, faqLd, SITE_URL } from '../../lib/seo';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await livePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const author = await getEntry(d.author);
const path = postUrl(post);
const minutes = readingMinutes(post.body);
const related = relatedPosts(post, all);
const hubExists = (await getCollection('hubs')).some((h) => h.data.path === d.silo);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: BLOG_CATEGORY_LABEL[d.category], href: blogCategoryUrl(d.category) }, { name: d.title, href: path }];
const postLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description, url: SITE_URL + path,
  mainEntityOfPage: SITE_URL + path, image: d.cover ? SITE_URL + d.cover : undefined,
  datePublished: d.publish_at.toISOString(), dateModified: (d.updated_at ?? d.publish_at).toISOString(),
  author: { '@type': author.id === 'editorial-team' ? 'Organization' : 'Person', name: author.data.name },
  publisher: { '@type': 'Organization', name: 'Print & Play Game', url: SITE_URL },
  keywords: [d.target_keyword, ...d.secondary_keywords].join(', '), articleSection: BLOG_CATEGORY_LABEL[d.category], wordCount: post.body?.split(/\s+/).length,
};
const jsonLd: object[] = [breadcrumbLd(crumbs), postLd];
if (d.faq.length) jsonLd.push(faqLd(d.faq));
---
<Base title={d.seo_title ?? d.title} description={d.description} path={path} ogType="article" active="blog" jsonLd={jsonLd} noindex={d.status !== 'published'}>
  <Fragment slot="head">
    <meta property="article:published_time" content={d.publish_at.toISOString()} />
    {d.updated_at && <meta property="article:modified_time" content={d.updated_at.toISOString()} />}
    {d.cover && <meta property="og:image" content={SITE_URL + d.cover} />}
  </Fragment>
  <Breadcrumb items={crumbs} />
  <div class="post-layout wrap">
    <article class="post">
      <header class="post-head">
        <a class="pill pill-accent" href={blogCategoryUrl(d.category)}>{BLOG_CATEGORY_LABEL[d.category]}</a>
        <h1>{d.title}</h1>
        <div class="byline">
          <span class="byline-avatar" aria-hidden="true">{author.data.name.replace(/^The /, '')[0]}</span>
          <span><strong>{author.data.name}</strong><br /><span class="byline-role">{author.data.role}</span></span>
          <span class="byline-meta">
            <time datetime={d.publish_at.toISOString()}>{fmtDate(d.publish_at)}</time>
            {d.updated_at && <> · updated <time datetime={d.updated_at.toISOString()}>{fmtDate(d.updated_at)}</time></>}
            {' · '}{minutes} min read
          </span>
        </div>
      </header>

      <section class="tldr" aria-label="Short answer">
        <p class="tldr-kicker">Short answer</p>
        <p class="tldr-text">{d.tldr}</p>
        {d.key_takeaways.length > 0 && <ul class="tldr-list">{d.key_takeaways.map((k) => <li>{k}</li>)}</ul>}
      </section>

      <AskAi url={SITE_URL + path} title={d.title} />
      <Toc headings={headings} mode="mobile" />

      {d.cover && <img class="post-cover" src={d.cover} alt={d.cover_alt ?? ''} width="1200" height="630" />}

      <div class="post-body prose">
        <Content />
      </div>

      {hubExists && <HubCta path={d.silo} />}

      {d.faq.length > 0 && (
        <section class="post-faq" aria-labelledby="faq">
          <h2 id="faq">Frequently asked questions</h2>
          {d.faq.map((f) => (<div class="post-faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>))}
        </section>
      )}

      {(d.sources.length > 0 || d.resources.length > 0) && (
        <div class="post-refs">
          {d.sources.length > 0 && (
            <section class="refs-box">
              <h2>Sources{d.sources_checked && <span> checked {fmtDate(d.sources_checked)}</span>}</h2>
              <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.label}</a></li>)}</ul>
            </section>
          )}
          {d.resources.length > 0 && (
            <section class="refs-box refs-internal">
              <h2>Useful pages on Print &amp; Play</h2>
              <ul>{d.resources.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
            </section>
          )}
        </div>
      )}

      <aside class="author-box">
        <span class="byline-avatar big" aria-hidden="true">{author.data.name.replace(/^The /, '')[0]}</span>
        <div><p class="author-name">{author.data.name}</p><p>{author.data.bio}</p></div>
      </aside>
    </article>
    <Toc headings={headings} mode="rail" />
  </div>

  {related.length > 0 && (
    <section class="section wrap">
      <div class="section-head"><h2>Keep reading</h2><a href="/blog/">All articles</a></div>
      <div class="post-grid">{related.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}
</Base>
