---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." path="/404/" noindex>
  <section class="wrap stack" style="padding-block:64px; --gap:16px; max-width:720px">
    <h1>Lost in the maze?</h1>
    <p class="lead">This page does not exist, or the game moved. Try the search, or start from the games.</p>
    <div class="row"><a class="btn btn-primary" href="/">Home</a><a class="btn btn-outline" href="/board-games/">Board games</a><a class="btn btn-outline" href="/puzzles/">Puzzles</a></div>
  </section>
</Base>
