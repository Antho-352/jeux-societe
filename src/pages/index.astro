---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ItemCard from '../components/ItemCard.astro';
import { gameItem, puzzleItem } from '../lib/listing';
import { SITE_URL } from '../lib/seo';
import VideoEmbed from '../components/VideoEmbed.astro';

const creators = await getCollection('creators');
const byId = new Map(creators.map((c) => [c.id, c.data.name]));
const games = (await getCollection('games')).filter((g) => g.data.status === 'published').sort((a, b) => b.data.date_added.getTime() - a.data.date_added.getTime());
const puzzles = (await getCollection('puzzles')).filter((p) => p.data.status === 'published').sort((a, b) => b.data.date_added.getTime() - a.data.date_added.getTime());
const rules = (await getCollection('rules')).filter((r) => r.data.status === 'published');
const hubs = await getCollection('hubs');
const featured = games.find((g) => g.data.featured) ?? games[0];
const withVideo = games.find((g) => g.data.video_id);
const fresh = games.filter((g) => g.id !== featured?.id).slice(0, 4);
const count = (path: string) => hubs.find((h) => h.data.path === path);
const tiles = [
  { href: '/board-games/', label: 'Board games', bg: '#CFFF5E', glyph: 'B' },
  { href: '/card-games/', label: 'Card games', bg: '#B8D8FF', glyph: 'C' },
  { href: '/escape-games/', label: 'Escape games', bg: '#FFD9D2', glyph: 'E' },
  { href: '/scavenger-hunts/', label: 'Scavenger hunts', bg: '#FFE8A3', glyph: 'S' },
  { href: '/roll-and-write/', label: 'Roll & write', bg: '#D9F2E6', glyph: 'R' },
  { href: '/puzzles/mazes/', label: 'Mazes', bg: '#CFFF5E', glyph: 'M' },
  { href: '/puzzles/dot-to-dot/', label: 'Dot to dot', bg: '#B8D8FF', glyph: 'D' },
  { href: '/puzzles/word-search/', label: 'Word search', bg: '#FFD9D2', glyph: 'W' },
  { href: '/bingo/', label: 'Bingo cards', bg: '#FFE8A3', glyph: 'B' },
  { href: '/rules/', label: 'Game rules', bg: '#D9F2E6', glyph: '?' },
];
const chips = [
  { label: 'Solo', href: '/board-games/solo/' }, { label: '2 players', href: '/board-games/2-player/' }, { label: 'Party', href: '/party-games/' },
  { label: 'Kids', href: '/board-games/kids/' }, { label: 'Classroom', href: '/classroom/' }, { label: 'Halloween', href: '/occasions/halloween/' }, { label: 'Christmas', href: '/occasions/christmas/' },
].filter((c) => hubs.some((h) => '/' + h.data.path + '/' === c.href));
const orgLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Print & Play Game', url: SITE_URL, potentialAction: { '@type': 'SearchAction', target: `${SITE_URL}/search/?q={search_term_string}`, 'query-input': 'required name=search_term_string' } };
---
<Base title="Free print and play games and printable puzzles (PDF)" description={`${games.length}+ free board games, card games, escape games and printable puzzles to download and print at home. Every PDF is credited to its designer. No account needed.`} path="/" jsonLd={[orgLd]}>
  <section class="wrap hero">
    <div class="stack" style="--gap:22px">
      <span class="sticker">Free PDFs · no account · credited to their creators</span>
      <h1>Print it.<br />Cut it.<br /><em>Play it tonight.</em></h1>
      <p class="lead">Hand-picked board games, card games, escape games and puzzles you can print at home. Every game is free, credited to its designer, and ready in minutes.</p>
      <div class="row">
        <a class="btn btn-primary btn-lg" href="/board-games/">Browse all games</a>
        <a class="btn btn-outline btn-lg" href="/find-a-game/">Help me choose</a>
      </div>
      {chips.length > 0 && <div class="row" style="--gap:8px">{chips.map((c) => <a class="chip" href={c.href}>{c.label}</a>)}</div>}
    </div>
    <div class="hero-art playloop" aria-hidden="true">
      <div class="stage">
        <div class="beat beat-dl">
          <p class="say">1. Download the PDF</p>
          <div class="browser">
            <div class="chrome"><i></i><i></i><i></i><em>printandplaygame.com</em></div>
            <strong>Scuttle</strong>
            <span class="dl-btn">Download PDF</span>
            <span class="bar"><i></i></span>
          </div>
          <span class="cursor"></span>
          <span class="file">Scuttle.pdf <b>✓</b></span>
        </div>
        <div class="beat beat-cut">
          <p class="say">2. Print, then cut</p>
          <div class="printer">Print<span class="paper"></span></div>
          <div class="sheet-page">
            <span>A</span><span>K</span><span>Q</span><span>J</span>
            <i class="cut h"></i><i class="cut v"></i>
            <svg class="scissors" viewBox="0 0 72 36" width="64" height="32"><circle cx="12" cy="10" r="7" fill="none" stroke="#0F3D2E" stroke-width="3"/><circle cx="12" cy="26" r="7" fill="none" stroke="#0F3D2E" stroke-width="3"/><path d="M18 12 L66 4 M18 24 L66 32" stroke="#0F3D2E" stroke-width="3" stroke-linecap="round"/></svg>
          </div>
        </div>
        <div class="beat beat-play">
          <p class="say">3. Play tonight</p>
          <div class="table"></div>
          <div class="seat s1"><i></i><em></em></div>
          <div class="seat s2"><i></i><em></em></div>
          <div class="seat s3"><i></i><em></em></div>
          <div class="seat s4"><i></i><em></em></div>
          <div class="pile"><span>A</span><span>K</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:40px">
    <div class="tiles">
      {tiles.map((t) => <a class="tile" href={t.href}><span class="glyph" style={`background:${t.bg}`}>{t.glyph}</span>{t.label}</a>)}
    </div>
  </section>

  {fresh.length > 0 && (
    <section class="section wrap" style="padding-top:0">
      <div class="section-head"><h2>Fresh off the printer</h2><a href="/board-games/">All games</a></div>
      <div class="grid">{fresh.map((g) => { const it = gameItem(g, g.data.creator ? byId.get(g.data.creator.id) : undefined); return <ItemCard href={it.href} title={it.title} by={it.by} typeLabel={it.typeLabel} cover={it.cover} colour={it.colour} pills={it.pills} />; })}</div>
    </section>
  )}

  {featured && (
    <section class="wrap" style="padding-bottom:48px">
      <div class="band" style="display:flex; flex-wrap:wrap; overflow:hidden">
        <div class="stack" style="flex:1 1 440px; padding:48px; --gap:16px; justify-content:center">
          <span class="pill pill-accent" style="align-self:flex-start">Game of the week</span>
          <h2 style="font-size:clamp(34px,4vw,52px)">{featured.data.title}</h2>
          <p class="lead">{featured.data.summary}</p>
          <div class="row" style="--gap:8px">
            {gameItem(featured).pills.map((p) => <span class="pill" style="background:transparent; border:1px solid #4B7A6A; color:var(--ground)">{p}</span>)}
          </div>
          <a class="btn btn-primary" href={gameItem(featured).href} style="align-self:flex-start">See the game</a>
        </div>
        <div style="flex:1 1 320px; min-height:300px; background:var(--accent); display:grid; place-items:center">
          <span class="display" style="font-size:180px; color:var(--ink); opacity:.85" aria-hidden="true">{featured.data.title[0]}</span>
        </div>
      </div>
    </section>
  )}

  <section class="wrap" style="padding-bottom:48px">
    <div class="panel" style="display:flex; flex-wrap:wrap; gap:32px; align-items:center; padding:40px">
      <div class="stack" style="flex:1 1 360px; --gap:10px">
        <span style="font-weight:800; color:var(--primary)">Game finder</span>
        <h2>Not sure what to print? Five quick questions.</h2>
        <p class="lead">Who's playing, how old, how long, what mood. We hand you the three best games.</p>
      </div>
      <a class="btn btn-dark btn-lg" href="/find-a-game/">Find my game</a>
    </div>
  </section>

  {puzzles.length > 0 && (
    <section class="section wrap" style="padding-top:0">
      <div class="section-head"><h2>Printable puzzles</h2><a href="/puzzles/">All puzzles</a></div>
      <div class="grid">{puzzles.slice(0, 4).map((p) => { const it = puzzleItem(p); return <ItemCard href={it.href} title={it.title} by={it.by} typeLabel={it.typeLabel} cover={it.cover} colour={it.colour} pills={it.pills} />; })}</div>
    </section>
  )}

  {withVideo && (
    <section class="wrap" style="padding-bottom:48px">
      <div class="band-tint" style="display:flex; flex-wrap:wrap; gap:32px; align-items:center; padding:32px">
        <div class="stack" style="flex:1 1 300px; --gap:12px">
          <span class="pill pill-ink" style="align-self:flex-start">On YouTube</span>
          <h2>{withVideo.data.title}, explained in a few minutes</h2>
          <p class="lead" style="color:var(--ink)">Watch how it plays, then print the free PDF. New games get their video on <a href="https://www.youtube.com/@printandplaygame" rel="noopener" target="_blank">Print &amp; Play Games</a>.</p>
          <a class="btn btn-dark" href={gameItem(withVideo).href} style="align-self:flex-start">Get the PDF</a>
        </div>
        <div style="flex:1 1 420px; min-width:0">
          <VideoEmbed id={withVideo.data.video_id!} title={`How to play ${withVideo.data.title}`} />
        </div>
      </div>
    </section>
  )}

  <section class="wrap" style="padding-bottom:48px">
    <div class="grid-2">
      <div class="panel stack" style="--gap:12px">
        <h2>Three steps, no fuss</h2>
        <p><strong>1. Download the PDF.</strong> One click, no account, no email wall.</p>
        <p><strong>2. Print at home.</strong> A4 or Letter, colour or black and white, plain paper is fine.</p>
        <p><strong>3. Cut and play.</strong> Scissors, a couple of dice from your drawer, done. <a href="/how-to-print/">Printing guide</a>.</p>
      </div>
      <div class="band-tint stack" style="padding:24px; --gap:12px">
        <h2>Game rules library</h2>
        <p class="lead" style="color:var(--ink)">{rules.length > 0 ? `${rules.length} classic games explained` : 'Classic games explained'}: setup, how to play, scoring and variants, with printable boards and score sheets for the public-domain ones.</p>
        <a class="btn btn-dark" href="/rules/" style="align-self:flex-start">Browse the rules</a>
      </div>
    </div>
  </section>
</Base>
