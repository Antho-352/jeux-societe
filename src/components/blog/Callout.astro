---
/** Highlight box. type: tip | note | warning | key | example */
interface Props { type?: 'tip' | 'note' | 'warning' | 'key' | 'example'; title?: string }
const { type = 'note', title } = Astro.props;
const META = {
  tip: { icon: 'M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z', label: 'Tip' },
  note: { icon: 'M12 16v-4M12 8h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z', label: 'Good to know' },
  warning: { icon: 'M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z', label: 'Watch out' },
  key: { icon: 'M20 6 9 17l-5-5', label: 'Key point' },
  example: { icon: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z', label: 'Example' },
}[type];
---
<aside class:list={['callout', `callout-${type}`]} role="note">
  <p class="callout-title">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d={META.icon} /></svg>
    {title ?? META.label}
  </p>
  <div class="callout-body"><slot /></div>
</aside>
