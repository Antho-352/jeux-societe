---
/** Table of contents: a column of small bars on the right (desktop) that expands on hover/focus; a collapsible list on mobile. */
interface Props { headings: { depth: number; slug: string; text: string }[]; mode: 'mobile' | 'rail' }
const { mode } = Astro.props;
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 2 && mode === 'mobile' && (
    <details class="toc-mobile">
      <summary>On this page</summary>
      <ol>{items.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </details>
)}
{items.length > 2 && mode === 'rail' && (
    <nav class="toc-rail" aria-label="On this page" data-toc>
      <ol class="toc-bars" aria-hidden="true">{items.map((h) => <li class={`d${h.depth}`} data-for={h.slug}><span></span></li>)}</ol>
      <div class="toc-panel">
        <p class="toc-title">On this page</p>
        <ol>{items.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-for={h.slug}>{h.text}</a></li>)}</ol>
      </div>
    </nav>
)}
<script>
  const rail = document.querySelector<HTMLElement>('[data-toc]');
  if (rail) {
    const ids = Array.from(rail.querySelectorAll<HTMLElement>('.toc-panel [data-for]')).map((a) => a.dataset.for!);
    const heads = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const setActive = (id: string) => rail.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => el.classList.toggle('is-active', el.dataset.for === id));
    const io = new IntersectionObserver((entries) => {
      const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (vis) setActive(vis.target.id);
    }, { rootMargin: '0px 0px -70% 0px' });
    heads.forEach((h) => io.observe(h));
  }
</script>
