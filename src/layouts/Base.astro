---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/blog.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pageTitle, SITE_NAME, SITE_URL } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;            // canonical path, with leading and trailing slash
  lang?: 'en' | 'fr';
  altPath?: string;        // path of the translation, when it exists
  noindex?: boolean;
  ogType?: string;
  jsonLd?: object[];
  active?: string;         // top-nav key
}
const { title, description, path, lang = 'en', altPath, noindex = false, ogType = 'website', jsonLd = [], active } = Astro.props;
const canonical = SITE_URL + path;
const fullTitle = pageTitle(title);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
  {!noindex && altPath && (
    <>
      <link rel="alternate" hreflang={lang} href={canonical} />
      <link rel="alternate" hreflang={lang === 'en' ? 'fr' : 'en'} href={SITE_URL + altPath} />
      <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : SITE_URL + altPath} />
    </>
  )}
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'fr_FR'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/fraunces-normal-600-900-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/outfit-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  <slot name="head" />
</head>
<body>
  <Header active={active} lang={lang} altPath={altPath} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
